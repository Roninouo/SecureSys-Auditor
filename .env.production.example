# SecureSys Auditor - Production Environment Template
#
# Copy this file to .env.production and set ALL required values.
# Do NOT commit real secrets.
#
# Usage (docker-compose):
#   docker-compose --env-file .env.production -f docker-compose.prod.yml up -d

# =============================================================================
# Core Django
# =============================================================================
ENVIRONMENT=production
DEBUG=False
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=api.example.com

# If you use the Django admin (sessions/CSRF), set CSRF_TRUSTED_ORIGINS.
# Must include scheme (https://) and exact host.
CSRF_TRUSTED_ORIGINS=https://app.example.com,https://api.example.com

# If the browser frontend is served from a different origin, configure CORS.
CORS_ALLOWED_ORIGINS=https://app.example.com

DJANGO_LOG_LEVEL=INFO

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
DB_NAME=securesys_db
DB_USER=securesys_user
DB_PASSWORD=
# In docker-compose.prod.yml the backend connects to "postgres" service.
DB_HOST=postgres
DB_PORT=5432

# =============================================================================
# Redis / Celery
# =============================================================================
# Required by docker-compose.prod.yml
REDIS_PASSWORD=

# Optional but recommended: use Redis as Django cache backend.
# NOTE: do not rely on variable expansion inside .env files; put the password inline.
# Example: redis://:YOUR_PASSWORD@redis:6379/1
REDIS_CACHE_URL=redis://:CHANGE_ME@redis:6379/1

# =============================================================================
# Security hardening (Django SecurityMiddleware)
# =============================================================================
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
USE_X_FORWARDED_HOST=True
USE_X_FORWARDED_PROTO=True

SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# =============================================================================
# OIDC / Keycloak (recommended in production)
# =============================================================================
OIDC_ENABLED=true
OIDC_ISSUER=https://id.example.com/realms/securesys
OIDC_AUDIENCE=securesys-backend

# =============================================================================
# Webhooks (optional)
# =============================================================================
WEBHOOK_ENABLED=true
WEBHOOK_SECRET=

# =============================================================================
# Observability (OpenTelemetry)
# =============================================================================
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SAMPLING_RATE=0.1

# =============================================================================
# Backups / Restore verification (docker-compose.prod)
# =============================================================================
BACKUP_RETENTION_DAYS=30
# Optional: used by scripts/db-restore-verify.sh (if configured)
BACKUP_ENCRYPTION_KEY=
PUSHGATEWAY_URL=http://pushgateway:9091

# =============================================================================
# Grafana
# =============================================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Adjust if you expose Grafana behind a reverse proxy
GRAFANA_ROOT_URL=https://grafana.example.com
