# Local/dev template Secret for Kubernetes.
#
# For production prefer ExternalSecrets / SealedSecrets.
# Replace all values before applying.
apiVersion: v1
kind: Secret
metadata:
  name: securesys-secrets
  namespace: securesys
type: Opaque
stringData:
  DJANGO_SECRET_KEY: "CHANGE_ME"
  DB_USER: "securesys_user"
  DB_PASSWORD: "CHANGE_ME"
  WEBHOOK_SECRET: "CHANGE_ME"
  # Optional: use if your Redis requires auth
  # CELERY_BROKER_URL: "redis://:CHANGE_ME@redis.securesys.svc.cluster.local:6379/0"
  # Optional: enable Redis cache backend
  # REDIS_CACHE_URL: "redis://:CHANGE_ME@redis.securesys.svc.cluster.local:6379/1"
