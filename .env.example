# SecureSys Auditor - Environment Configuration Template
# Copy this file to .env and set values.
#
# SECURITY WARNING: NEVER commit .env files with real secrets to version control!
# This template contains ONLY placeholders - generate real values before use.
#
# Generate secrets using:
#   DJANGO_SECRET_KEY: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#   DB_PASSWORD: openssl rand -base64 32
#   Other passwords: Use a password manager or `openssl rand -base64 24`

# =============================================================================
# Django Backend Settings
# =============================================================================
DJANGO_SECRET_KEY=<GENERATE_ME_USING_DJANGO_GET_RANDOM_SECRET_KEY>
DEBUG=True
ENVIRONMENT=development
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# =============================================================================
# Database Configuration (PostgreSQL)
# =============================================================================
DB_NAME=securesys_db
DB_USER=securesys_user
DB_PASSWORD=<GENERATE_STRONG_PASSWORD>
DB_HOST=postgres
DB_PORT=5432

# =============================================================================
# Redis / Celery Configuration
# =============================================================================
REDIS_PORT=6380
CELERY_BROKER_URL=redis://redis:6379/0

# =============================================================================
# Service Ports
# =============================================================================
BACKEND_PORT=8000
FRONTEND_PORT=3000
KEYCLOAK_PORT=8080

# =============================================================================
# CORS Configuration
# =============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# OIDC/Keycloak Configuration (optional)
# =============================================================================
OIDC_ENABLED=false
OIDC_ISSUER=http://keycloak:8080/realms/securesys
OIDC_AUDIENCE=securesys-backend

# =============================================================================
# Keycloak Admin (optional - for initial setup)
# =============================================================================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=<GENERATE_STRONG_PASSWORD>
KC_DB_USER=keycloak
KC_DB_PASSWORD=<GENERATE_STRONG_PASSWORD>

# =============================================================================
# OpenTelemetry Configuration (optional)
# =============================================================================
OTEL_ENABLED=false
OTEL_SERVICE_NAME=securesys-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317

# =============================================================================
# Webhook Configuration (optional)
# =============================================================================
WEBHOOK_ENABLED=false
WEBHOOK_SECRET=<GENERATE_HMAC_SECRET_IF_ENABLED>

# =============================================================================
# Log Level
# =============================================================================
DJANGO_LOG_LEVEL=INFO
