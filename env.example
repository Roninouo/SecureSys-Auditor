# SecureSys Auditor - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED IN PRODUCTION
# =============================================================================

# Django secret key - MUST be set in production
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here

# Allowed hostnames - MUST be set in production
# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=your-domain.com,api.your-domain.com

# =============================================================================
# ENVIRONMENT SETTINGS
# =============================================================================

# Environment: development, staging, or production
ENVIRONMENT=development

# Debug mode - MUST be False in production
DEBUG=False

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

DB_NAME=securesys_db
DB_USER=securesys_user
DB_PASSWORD=your-secure-password
DB_HOST=localhost
DB_PORT=5432

# =============================================================================
# REDIS / CELERY CONFIGURATION
# =============================================================================

CELERY_BROKER_URL=redis://localhost:6379/0
REDIS_PORT=6379

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Allowed origins for CORS - comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# DOCKER PORTS (for docker-compose)
# =============================================================================

BACKEND_PORT=8000

# =============================================================================
# AGENT CONFIGURATION
# =============================================================================

# API URL for agent to connect to (must use HTTPS in production)
SECURESYS_API_URL=https://api.your-domain.com

# API Key for agent authentication (also used for payload signing)
SECURESYS_API_KEY=your-api-key-here

# Enable minimal telemetry mode (filters sensitive data)
SECURESYS_MINIMAL_TELEMETRY=true

# =============================================================================
# KEYCLOAK / OIDC CONFIGURATION (Phase 2: Enterprise SSO)
# =============================================================================

# Enable OIDC authentication (set to True to use Keycloak)
OIDC_ENABLED=False

# Keycloak server URL (without trailing slash)
OIDC_ISSUER=http://localhost:8080/realms/securesys

# OIDC Client configuration
OIDC_CLIENT_ID=securesys-backend
OIDC_CLIENT_SECRET=your-client-secret-here

# OIDC Audience (usually same as client ID)
OIDC_AUDIENCE=securesys-backend

# JWKS caching (seconds)
OIDC_JWKS_CACHE_TTL=3600

# =============================================================================
# OPENTELEMETRY OBSERVABILITY (Phase 2: Enterprise Monitoring)
# =============================================================================

# Enable OpenTelemetry tracing and metrics
OTEL_ENABLED=False

# Service name for traces
OTEL_SERVICE_NAME=securesys-auditor

# OTLP exporter endpoint (Jaeger, Zipkin, or collector)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# =============================================================================
# WEBHOOK CONFIGURATION (Phase 2: SIEM Integration)
# =============================================================================

# Enable webhook notifications
WEBHOOK_ENABLED=False

# Secret key for webhook payload HMAC signing
WEBHOOK_SECRET=your-webhook-secret-here

# =============================================================================
# PDF REPORTS CONFIGURATION (Phase 2: Advanced Reporting)
# =============================================================================

# Directory for storing generated reports
REPORTS_DIR=/app/reports

# Maximum report retention days (0 = forever)
REPORTS_RETENTION_DAYS=90
