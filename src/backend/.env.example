# SecureSys Auditor - Environment Configuration
# Copy this file to .env and configure values

# Django Settings
DJANGO_SECRET_KEY=your-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL)
DB_NAME=securesys_db
DB_USER=securesys_user
DB_PASSWORD=securesys_password
DB_HOST=localhost
DB_PORT=5432

# Celery Configuration (Redis)
CELERY_BROKER_URL=redis://localhost:6380/0

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Log Level
DJANGO_LOG_LEVEL=INFO

# JWT Settings (optional - defaults in settings.py)
# ACCESS_TOKEN_LIFETIME_HOURS=1
# REFRESH_TOKEN_LIFETIME_DAYS=7
